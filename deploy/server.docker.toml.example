# Docker Compose 服务端配置示例（挂载至容器内 /etc/cx/server.toml）

[http]
listen = "0.0.0.0:8080"
external_url = "https://cx.example.com"
trusted_proxies = ["127.0.0.1/32", "::1/128", "172.16.0.0/12"]

[quic]
listen = "0.0.0.0:8443"
public_addr = "cx.example.com:8443"
server_name = "cx.example.com"
cert = "/etc/cx/certs/fullchain.pem"
key = "/etc/cx/certs/privkey.pem"
cert_reload_secs = 300
keep_alive_secs = 15
max_idle_timeout_secs = 60
max_concurrent_bidi_streams = 256

[oidc]
issuer = "https://auth.example.com/realms/company"
client_id = "cx-gateway"
client_secret_env = "CX_OIDC_CLIENT_SECRET"
groups_claim = "groups"
admin_groups = ["cx-admins"]

[postgres]
host = "postgres"
port = 5432
database = "cx"
username = "cx"
password_env = "CX_POSTGRES_PASSWORD"
ssl_mode = "prefer"
max_connections = 16

[security]
block_private_ips = true
session_ttl_secs = 900
# 仅在 Profile 使用 [secrets.*] source = "db" 或调用 POST /v1/secrets 时按需配置：
# master_key_env = "CX_MASTER_KEY"

[dirs]
providers = "/etc/cx/providers"
enable_builtin_providers = true
